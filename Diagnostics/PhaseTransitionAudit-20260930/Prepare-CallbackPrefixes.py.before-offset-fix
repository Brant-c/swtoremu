def track_calls(data, base, sites):
    # Only named HM.TrackLine relocations observed in reader Assembly. Similar
    # MOV/CALL bytes also construct temporary objects and are not checkpoints.
    result=[]
    for ret,line in sites:
        assert data[base+ret-12:base+ret-9] == bytes.fromhex('C7 04 24')
        assert struct.unpack_from('<I',data,base+ret-9)[0] == line
        assert data[base+ret-5:base+ret] == bytes.fromhex('E8 FC FF FF FF')
        result.append({'return_offset':hex(ret),'line':line})
    return result

