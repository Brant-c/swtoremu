+            if (!TryReadPackedUnsigned(body, ref offset, out type) ||
+                type != 1 ||
+                !TryReadPackedUnsigned(body, ref offset,
+                    out abilitySpecId) ||
+                offset != body.Length)
+            {
+                failure = "bad-typed-arguments";
+                return false;
+            }
+            failure = null;
+            return true;
+        }
